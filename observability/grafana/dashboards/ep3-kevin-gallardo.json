    {
      "id": 2,
      "type": "timeseries",
      "title": "Duración histórica del job de despliegue",
      "description": "Inicio → fin del job GitHub Actions; no certifica disponibilidad ni rollout. Resultado según GitHub.",
      "datasource": {
        "type": "prometheus",
        "uid": "vicity-ci-history"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 12,
        "h": 8
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "noValue": "Sin datos"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "vicity-ci-history"
          },
          "refId": "A",
          "expr": "last_over_time(vicity_ci_deployment_duration_seconds{branch=~\"${branch:regex}\",environment=~\"${deploy_environment:regex}\"}[$__interval])",
          "legendFormat": "{{environment}} · {{branch}} · {{result}}",
          "instant": false,
          "range": true
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Último despliegue por entorno y rama",
      "description": "Última muestra en el rango, aun si falló. timestamp(last_over_time) usa el timestamp de la muestra disponible; muestra empates si los timestamps coinciden.",
      "datasource": {
        "type": "prometheus",
        "uid": "vicity-ci-history"
      },
      "gridPos": {
        "x": 12,
        "y": 1,
        "w": 12,
        "h": 8
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "graphMode": "none",
        "textMode": "value_and_name"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "noValue": "Sin datos"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "vicity-ci-history"
          },
          "refId": "A",
          "expr": "last_over_time(vicity_ci_deployment_duration_seconds{branch=~\"${branch:regex}\",environment=~\"${deploy_environment:regex}\"}[$__range]) and (timestamp(last_over_time(vicity_ci_deployment_duration_seconds{branch=~\"${branch:regex}\",environment=~\"${deploy_environment:regex}\"}[$__range])) == on(environment,branch) group_left max by (environment,branch) (timestamp(last_over_time(vicity_ci_deployment_duration_seconds{branch=~\"${branch:regex}\",environment=~\"${deploy_environment:regex}\"}[$__range]))))",
          "legendFormat": "{{environment}} · {{branch}} · {{result}}",
          "instant": true,
          "range": false
        }
      ]
