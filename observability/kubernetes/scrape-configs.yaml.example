# Agregar estos jobs al scrape_configs del Prometheus existente (sin Operator).
# Sustituir todos los replace-* por los valores acordados con Paulo.
scrape_configs:
  - job_name: vicity-backend
    metrics_path: /metrics
    scheme: http
    scrape_interval: 30s
    scrape_timeout: 10s
    kubernetes_sd_configs:
      - role: endpointslice
        namespaces:
          names: [replace-app-namespace]
    relabel_configs:
      - source_labels: [__meta_kubernetes_service_name, __meta_kubernetes_endpointslice_port_name, __meta_kubernetes_endpointslice_endpoint_conditions_ready, __meta_kubernetes_endpointslice_address_type]
        regex: 'replace-backend-service;replace-backend-port-name;true;IPv4'
        action: keep
  - job_name: vicity-frontend
    metrics_path: /metrics
    scheme: http
    scrape_interval: 30s
    scrape_timeout: 10s
    kubernetes_sd_configs:
      - role: endpointslice
        namespaces:
          names: [replace-app-namespace]
    relabel_configs:
      - source_labels: [__meta_kubernetes_service_name, __meta_kubernetes_endpointslice_port_name, __meta_kubernetes_endpointslice_endpoint_conditions_ready, __meta_kubernetes_endpointslice_address_type]
        regex: 'replace-frontend-service;replace-frontend-port-name;true;IPv4'
        action: keep
